#!/bin/bash
# BiRD Monitor 命令行
#   本机：  bird-monitor [open|start|stop|restart|status]（默认 open：没在跑就先启动再打开网页）
#   远程：  bird-monitor pro [open|sync|stop|status]
#           在远程 Mac 上跑同一份监控器，通过 SSH 隧道在本机看（远程服务仍只监听它自己的 127.0.0.1）
#           远程主机默认 ssh 别名 pro，可用 BIRD_MONITOR_REMOTE 改；本机隧道端口默认 8791（BIRD_MONITOR_TUNNEL_PORT）
set -u
# 解析软链接（~/.local/bin/bird-monitor -> 仓库里的 bin/bird-monitor），找到 server.py 所在目录
SRC="${BASH_SOURCE[0]}"
while [ -L "${SRC}" ]; do
  DIR="$(cd "$(dirname "${SRC}")" && pwd)"; SRC="$(readlink "${SRC}")"
  case "${SRC}" in /*) ;; *) SRC="${DIR}/${SRC}" ;; esac
done
HERE="$(cd "$(dirname "${SRC}")/.." && pwd)"
PORT="${BIRD_MONITOR_PORT:-8790}"
LOG="$HOME/Library/Logs/BirdMonitor.log"
URL="http://127.0.0.1:${PORT}/"
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
PY="$(command -v python3)"

pid_of() { lsof -tnP -iTCP:"${PORT}" -sTCP:LISTEN 2>/dev/null | head -1; }

is_ours() {
  local pid; pid="$(pid_of)"
  [ -n "${pid}" ] && ps -p "${pid}" -o command= | grep -q 'server.py'
}

start() {
  if is_ours; then echo "已在运行：${URL}（PID $(pid_of)）"; return 0; fi
  if [ -n "$(pid_of)" ]; then echo "端口 ${PORT} 被其他程序占用，可用 BIRD_MONITOR_PORT=xxxx 换端口" >&2; return 1; fi
  mkdir -p "$(dirname "${LOG}")"
  BIRD_MONITOR_PORT="${PORT}" nohup "${PY}" -I "${HERE}/server.py" </dev/null >>"${LOG}" 2>&1 &
  for _ in $(seq 1 100); do is_ours && { echo "已启动：${URL}"; return 0; }; /bin/sleep 0.1; done
  echo "启动失败，看日志：${LOG}" >&2; return 1
}

stop() {
  if is_ours; then kill -TERM "$(pid_of)"; echo "已停止"; else echo "没有在运行"; fi
}

# ---------------------------------------------------------------- 远程（默认 pro）
REMOTE="${BIRD_MONITOR_REMOTE:-pro}"
TPORT="${BIRD_MONITOR_TUNNEL_PORT:-8791}"
RDIR="code/bird-monitor"          # 相对远程 home
RCMD="${RDIR}/bin/bird-monitor"
SSH=(ssh -o ConnectTimeout=10 -o BatchMode=yes)

tunnel_pid() {
  local pid; pid="$(lsof -tnP -iTCP:"${TPORT}" -sTCP:LISTEN 2>/dev/null | head -1)"
  [ -n "${pid}" ] && ps -p "${pid}" -o command= | grep -q "^ssh .*${TPORT}:127.0.0.1:${PORT}" && echo "${pid}"
}

remote_sync() {
  echo "同步代码到 ${REMOTE}:~/${RDIR} …"
  "${SSH[@]}" "${REMOTE}" "mkdir -p ${RDIR}" || return 1
  rsync -a --delete --exclude .git --exclude __pycache__ -e "ssh -o ConnectTimeout=10 -o BatchMode=yes" \
    "${HERE}/" "${REMOTE}:${RDIR}/" || return 1
  "${SSH[@]}" "${REMOTE}" "${RCMD} restart"
}

remote_start() {
  if ! "${SSH[@]}" "${REMOTE}" "test -x ${RCMD}"; then remote_sync || return 1; fi
  "${SSH[@]}" "${REMOTE}" "${RCMD} start"
}

tunnel_up() {
  local pid; pid="$(tunnel_pid)"
  if [ -n "${pid}" ]; then echo "隧道已在：127.0.0.1:${TPORT} → ${REMOTE}（PID ${pid}）"; return 0; fi
  if lsof -tnP -iTCP:"${TPORT}" -sTCP:LISTEN >/dev/null 2>&1; then
    echo "本机端口 ${TPORT} 被其他程序占用，可用 BIRD_MONITOR_TUNNEL_PORT=xxxx 换端口" >&2; return 1
  fi
  "${SSH[@]}" -f -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
    -L "127.0.0.1:${TPORT}:127.0.0.1:${PORT}" "${REMOTE}" || return 1
  echo "隧道已建立：http://127.0.0.1:${TPORT}/ → ${REMOTE}"
}

tunnel_down() {
  local pid; pid="$(tunnel_pid)"
  if [ -n "${pid}" ]; then kill "${pid}"; echo "隧道已关闭"; else echo "隧道没开"; fi
}

remote_main() {
  case "${1:-open}" in
    open) remote_start && tunnel_up && open "http://127.0.0.1:${TPORT}/" ;;
    sync) remote_sync && tunnel_up ;;
    stop) tunnel_down; "${SSH[@]}" "${REMOTE}" "test -x ${RCMD} && ${RCMD} stop" ;;
    status)
      if "${SSH[@]}" "${REMOTE}" "test -x ${RCMD}"; then echo -n "${REMOTE} 上的服务："; "${SSH[@]}" "${REMOTE}" "${RCMD} status"
      else echo "${REMOTE} 上还没装（bird-monitor pro sync 安装）"; fi
      if [ -n "$(tunnel_pid)" ]; then echo "隧道：http://127.0.0.1:${TPORT}/（PID $(tunnel_pid)）"; else echo "隧道：未开"; fi ;;
    *) echo "用法：bird-monitor pro [open|sync|stop|status]"; exit 2 ;;
  esac
}

case "${1:-open}" in
  pro) shift; remote_main "$@" ;;
  start) start ;;
  stop) stop ;;
  restart) stop; /bin/sleep 1; start ;;
  status) if is_ours; then echo "运行中：${URL}（PID $(pid_of)）"; else echo "未运行"; fi ;;
  open) start && open "${URL}" ;;
  *) echo "用法：bird-monitor [open|start|stop|restart|status] | bird-monitor pro [open|sync|stop|status]"; exit 2 ;;
esac
